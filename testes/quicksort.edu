// PROCEDIMENTO AUXILIAR PARA TROCA DE VALORES
procedimento Trocar (ref vetor: Inteiro[], i: Inteiro, j: Inteiro) inicio
    aux: Inteiro = vetor[i]
    vetor[i] = vetor[j]
    vetor[j] = aux
fim

// FUNÇÃO PARA PARTICIONAR O VETOR
funcao Particionar (ref vetor: Inteiro[], inicio_vetor: Inteiro, fim_vetor: Inteiro) ->
Inteiro inicio
    pivo: Inteiro = vetor[fim_vetor]
    i: Inteiro = inicio_vetor - 1
    j: Inteiro = inicio_vetor
    
    enquanto (j < fim_vetor) inicio
        se (vetor[j] <= pivo) inicio
            i = i + 1
            Trocar(vetor, i, j)
        fim_se
        j = j + 1
    fim_enquanto

    Trocar(vetor, i + 1, fim_vetor)
    retornar (i + 1)
fim

// PROCEDIMENTO RECURSIVO DO QUICKSORT
procedimento QuickSort (ref vetor: Inteiro[], inicio_vetor: Inteiro, fim_vetor:
Inteiro) inicio
    se (inicio_vetor < fim_vetor) inicio
        pivo: Inteiro = Particionar(vetor, inicio_vetor, fim_vetor)

        QuickSort(vetor, inicio_vetor, pivo - 1)
        QuickSort(vetor, pivo + 1, fim_vetor)
    fim_se
fim

// PROGRAMA PRINCIPAL
procedimento main() inicio
    numeros: Inteiro[100]
    tamanho: Inteiro
    cont: Inteiro = 1

    Escrever("Quantos números deseja ordenar (limite de 100)?")
    tamanho = LerInteiro()