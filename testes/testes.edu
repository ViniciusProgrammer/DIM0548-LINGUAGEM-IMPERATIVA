inicio
  Inteiro  numero
  Real     nota
  Texto    palavra
  Booleano ativo
  Constante MAX: Inteiro = 100

  numero = 42
  nota   = 9.5
  palavra = "ola mundo"
  ativo  = Verdadeiro

  numero = numero + 1
  numero = numero - 1
  numero = numero * 2
  numero = numero / 2
  numero = numero % 3

  numero += 5
  numero -= 2
  numero *= 3
  numero /= 4

  se (numero == 10) inicio
    ativo = Verdadeiro
  fim_se

  se (numero != 0) inicio
    ativo = Falso
  fim_se

  se (nota >= 7.0) inicio
    Escrever("Aprovado")
  fim_se

  se (nota <= 4.9) inicio
    Escrever("Reprovado")
  fim_se

  se (ativo && numero > 0) inicio
    Escrever("ativo e positivo")
  fim_se

  se (ativo || numero == 0) inicio
    Escrever("ativo ou zero")
  fim_se

  se !ativo inicio
    Escrever("inativo")
  fim_se

  enquanto (numero > 0) inicio
    numero -= 1
  fim_enquanto

  repetir
    numero += 1
  ate (numero == 5)

  se Verdadeiro inicio
    enquanto Falso inicio
      numero = numero + 1
    fim_enquanto
  fim_se

  numeros: Inteiro[10]
  numeros[0] = 1
  numeros[9] = MAX

  // Caractere invalido
  @

fim
