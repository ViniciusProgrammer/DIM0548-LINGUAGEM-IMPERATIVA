/* Cobertura geral da sintaxe da linguagem .edu. */

funcao dobro(valor: Inteiro) -> Inteiro inicio
    retorne valor * 2
fim

procedimento main() inicio
    numero: Inteiro = 42
    nota: Real = 9.5
    palavra: Texto = "ola mundo"
    ativo: Booleano = Verdadeiro
    Constante MAX: Inteiro = 100
    numeros: Inteiro[10]

    numero = numero + 1
    numero = numero - 1
    numero = numero * 2
    numero = numero / 2
    numero = numero % 3

    numero += 5
    numero -= 2
    numero *= 3
    numero /= 4

    se (numero == 10) inicio
        ativo = Verdadeiro
    senao inicio
        ativo = Falso
    fim_se

    se (nota >= 7.0 && ativo) inicio
        Escrever("Aprovado")
    fim_se

    se (nota <= 4.9 || !ativo) inicio
        Escrever("Reprovado")
    fim_se

    enquanto (numero > 0) inicio
        numero -= 1
    fim_enquanto

    repetir
        numero += 1
    ate (numero == 5)

    numeros[0] = dobro(numero)
    numeros[9] = MAX

    Escrever(palavra)
    Escrever(numeros[0])
fim
