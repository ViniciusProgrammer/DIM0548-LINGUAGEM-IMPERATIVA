procedimento main() inicio
    numero: Inteiro
    faixa1: Inteiro = 0
    faixa2: Inteiro = 0
    faixa3: Inteiro = 0
    faixa4: Inteiro = 0

    Escrever("Digite um número qualquer(digite um número negativo para encerrar):")
    Ler(numero)

    enquanto (numero >= 0) inicio
        se (numero >= 0 && numero <= 25) inicio
            faixa1 = faixa1 + 1
        fim_se
        se (numero >= 26 && numero <= 50) inicio
            faixa2 = faixa2 + 1
        fim_se
        se (numero >= 51 && numero <= 75) inicio
            faixa3 = faixa3 + 1
        fim_se
        se (numero >= 76 && numero <= 100) inicio
            faixa4 = faixa4 + 1
        fim_se
        Escrever("Digite outro número (ao digitar um número negativo o programa será encerrado):")
        Ler(numero)
    fim_enquanto

    Escrever("Resultados:")
    Escrever("Intervalo [0, 25]:  ")
    Escrever(faixa1)
    Escrever("Intervalo [26, 50]: ")
    Escrever(faixa2)
    Escrever("Intervalo [51, 75]: ")
    Escrever(faixa3)
    Escrever("Intervalo [76, 100]:")
    Escrever(faixa4)
fim