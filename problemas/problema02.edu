    faixa2: Inteiro = 0
    faixa3: Inteiro = 0
    faixa4: Inteiro = 0

    Escrever("Digite um número (negativo para encerrar):")
    numero = LerInteiro()

    enquanto (numero >= 0) início
        se (numero >= 0 e numero <= 25) início
            faixa1 = faixa1 + 1
        fim_se
        se (numero >= 26 e numero <= 50) início
            faixa2 = faixa2 + 1
        fim_se
        se (numero >= 51 e numero <= 75) início
            faixa3 = faixa3 + 1
        fim_se
