procedimento mdc(n: Inteiro, m: Inteiro, ref r: Inteiro) inicio
    se (n == m) inicio
        r = n
        retorne
    fim_se

    se (n > m) inicio
        mdc(n - m, m, r)
    senao inicio
        mdc(n, m - n, r)
    fim_se
fim

procedimento main() inicio
    n_mdc: Inteiro = 0
    m_mdc: Inteiro = 0
    resultado_mdc: Inteiro = 0

    Ler(n_mdc)
    Ler(m_mdc)
    
    mdc(n_mdc, m_mdc, resultado_mdc)
    
    Escrever(resultado_mdc)
fim