// PROBLEMA 4: Numeros racionais com vetores paralelos (num[], den[])
// rational_t simulado: indice 0 = unico racional usado por vez

funcao mdc(a: Inteiro, b: Inteiro) -> Inteiro inicio
    se (b == 0) inicio
        retorne a
    fim_se
    retorne mdc(b, a % b)
fim

// Simplifica e armazena em pos do vetor
procedimento criarRacional(ref num: Inteiro[], ref den: Inteiro[], pos: Inteiro, a: Inteiro, b: Inteiro) inicio
    d: Inteiro = mdc(a, b)
    num[pos] = a / d
    den[pos] = b / d
fim

// Compara dois racionais: retorna 1 se iguais
funcao igual(ref num: Inteiro[], ref den: Inteiro[], p: Inteiro, q: Inteiro) -> Inteiro inicio
    se (num[p] * den[q] == num[q] * den[p]) inicio
        retorne 1
    fim_se
    retorne 0
fim

// Soma: res = p + q
procedimento somaR(ref num: Inteiro[], ref den: Inteiro[], p: Inteiro, q: Inteiro, res: Inteiro) inicio
    criarRacional(num, den, res, num[p] * den[q] + num[q] * den[p], den[p] * den[q])
fim

// Negacao: res = -p
procedimento negacaoR(ref num: Inteiro[], ref den: Inteiro[], p: Inteiro, res: Inteiro) inicio
    num[res] = -num[p]
    den[res] = den[p]
fim

// Subtracao: res = p - q
procedimento subtracaoR(ref num: Inteiro[], ref den: Inteiro[], p: Inteiro, q: Inteiro, res: Inteiro) inicio
    criarRacional(num, den, res, num[p] * den[q] - num[q] * den[p], den[p] * den[q])
fim

// Multiplicacao: res = p * q
procedimento multiplicacaoR(ref num: Inteiro[], ref den: Inteiro[], p: Inteiro, q: Inteiro, res: Inteiro) inicio
    criarRacional(num, den, res, num[p] * num[q], den[p] * den[q])
fim

// Inverso: res = 1/p
procedimento inversoR(ref num: Inteiro[], ref den: Inteiro[], p: Inteiro, res: Inteiro) inicio
    num[res] = den[p]
    den[res] = num[p]
fim

// Divisao: res = p / q
procedimento divisaoR(ref num: Inteiro[], ref den: Inteiro[], p: Inteiro, q: Inteiro, res: Inteiro) inicio
    criarRacional(num, den, res, num[p] * den[q], den[p] * num[q])
fim

procedimento imprimirR(ref num: Inteiro[], ref den: Inteiro[], pos: Inteiro) inicio
    Escrever("Numerador:")
    Escrever(num[pos])
    Escrever("Denominador:")
    Escrever(den[pos])
fim

procedimento main() inicio
    num: Inteiro[10]
    den: Inteiro[10]
    res: Inteiro = 0

    // Cria 1/2 no indice 0 e 2/4 no indice 1
    criarRacional(num, den, 0, 1, 2)
    criarRacional(num, den, 1, 2, 4)

    Escrever("Racional A (1/2):")
    imprimirR(num, den, 0)
    Escrever("Racional B (2/4):")
    imprimirR(num, den, 1)

    Escrever("Sao iguais?")
    Escrever(igual(num, den, 0, 1))

    somaR(num, den, 0, 1, 2)
    Escrever("Soma:")
    imprimirR(num, den, 2)

    negacaoR(num, den, 0, 3)
    Escrever("Negacao de A:")
    imprimirR(num, den, 3)

    subtracaoR(num, den, 0, 1, 4)
    Escrever("Subtracao A-B:")
    imprimirR(num, den, 4)

    multiplicacaoR(num, den, 0, 1, 5)
    Escrever("Multiplicacao A*B:")
    imprimirR(num, den, 5)

    inversoR(num, den, 0, 6)
    Escrever("Inverso de A:")
    imprimirR(num, den, 6)

    divisaoR(num, den, 0, 1, 7)
    Escrever("Divisao A/B:")
    imprimirR(num, den, 7)
fim
