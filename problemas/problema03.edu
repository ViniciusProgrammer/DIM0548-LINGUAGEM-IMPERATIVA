procedimento main() inicio
    linhasA: Inteiro = 0
    colunasA: Inteiro = 0
    linhasB: Inteiro = 0
    colunasB: Inteiro = 0

    matA: Inteiro[100]
    matB: Inteiro[100]
    soma: Inteiro[100]
    prod: Inteiro[100]

    i: Inteiro = 0
    j: Inteiro = 0
    k: Inteiro = 0
    acum: Inteiro = 0

    Escrever("Linhas da matriz A:")
    linhasA = LerInteiro()
    Escrever("Colunas da matriz A:")
    colunasA = LerInteiro()

    i = 0
    enquanto (i < linhasA) inicio
        j = 0
        enquanto (j < colunasA) inicio
            Escrever("A[")
            Escrever(i)
            Escrever("][")
            Escrever(j)
            Escrever("]: ")
            matA[i * colunasA + j] = LerInteiro()
            j = j + 1
        fim_enquanto
        i = i + 1
    fim_enquanto

    Escrever("Linhas da matriz B:")
    linhasB = LerInteiro()
    Escrever("Colunas da matriz B:")
    colunasB = LerInteiro()

    i = 0
    enquanto (i < linhasB) inicio
        j = 0
        enquanto (j < colunasB) inicio
            Escrever("B[")
            Escrever(i)
            Escrever("][")
            Escrever(j)
            Escrever("]: ")
            matB[i * colunasB + j] = LerInteiro()
            j = j + 1
        fim_enquanto
        i = i + 1
    fim_enquanto

    // Soma: so e possivel se as dimensoes forem iguais
    se (linhasA == linhasB && colunasA == colunasB) inicio
        Escrever("Soma das matrizes:")
        i = 0
        enquanto (i < linhasA) inicio
            j = 0
            enquanto (j < colunasA) inicio
                soma[i * colunasA + j] = matA[i * colunasA + j] + matB[i * colunasB + j]
                Escrever(soma[i * colunasA + j])
                Escrever(" ")
                j = j + 1
            fim_enquanto
            Escrever("")
            i = i + 1
        fim_enquanto
    senao inicio
        Escrever("Soma impossivel: as matrizes possuem dimensoes diferentes.")
    fim_se

    // Produto: so e possivel se colunasA == linhasB
    se (colunasA == linhasB) inicio
        Escrever("Produto das matrizes:")
        i = 0
        enquanto (i < linhasA) inicio
            j = 0
            enquanto (j < colunasB) inicio
                acum = 0
                k = 0
                enquanto (k < colunasA) inicio
                    acum = acum + matA[i * colunasA + k] * matB[k * colunasB + j]
                    k = k + 1
                fim_enquanto
                prod[i * colunasB + j] = acum
                Escrever(prod[i * colunasB + j])
                Escrever(" ")
                j = j + 1
            fim_enquanto
            Escrever("")
            i = i + 1
        fim_enquanto
    senao inicio
        Escrever("Produto impossivel: colunas de A diferem das linhas de B.")
    fim_se
fim
