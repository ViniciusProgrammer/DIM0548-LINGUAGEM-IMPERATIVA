funcao mdc(a: Inteiro, b: Inteiro) -> Inteiro
inicio
    se (a < 0) inicio
        a = -a
    fim_se

    se (b < 0) inicio
        b = -b
    fim_se

    se (b == 0) inicio
        retorne a
    fim_se

    retorne mdc(b, a % b)
fim

funcao criar_racional(a: Inteiro, b: Inteiro) -> rational_t
inicio
    resultado: rational_t
    divisor: Inteiro

    se (b == 0) inicio
        resultado.numerador = 0
        resultado.denominador = 1
        retorne resultado
    fim_se

    divisor = mdc(a, b)
    resultado.numerador = a / divisor
    resultado.denominador = b / divisor

    se (resultado.denominador < 0) inicio
        resultado.numerador = -resultado.numerador
        resultado.denominador = -resultado.denominador
    fim_se

    retorne resultado
fim

funcao racionais_iguais(r1: rational_t, r2: rational_t) -> Booleano
inicio
    retorne r1.numerador * r2.denominador == r2.numerador * r1.denominador
fim

funcao somar_racionais(r1: rational_t, r2: rational_t) -> rational_t
inicio
    retorne criar_racional(r1.numerador * r2.denominador + r1.denominador * r2.numerador, r1.denominador * r2.denominador)
fim

funcao negar_racional(r: rational_t) -> rational_t
inicio
    retorne criar_racional(-r.numerador, r.denominador)
fim

funcao subtrair_racionais(r1: rational_t, r2: rational_t) -> rational_t
inicio
    retorne criar_racional(r1.numerador * r2.denominador - r1.denominador * r2.numerador, r1.denominador * r2.denominador)
fim

funcao multiplicar_racionais(r1: rational_t, r2: rational_t) -> rational_t
inicio
    retorne criar_racional(r1.numerador * r2.numerador, r1.denominador * r2.denominador)
fim

funcao inverso_racional(r: rational_t) -> rational_t
inicio
    se (r.numerador == 0) inicio
        retorne criar_racional(0, 1)
    fim_se

    retorne criar_racional(r.denominador, r.numerador)
fim

funcao dividir_racionais(r1: rational_t, r2: rational_t) -> rational_t
inicio
    se (r2.numerador == 0) inicio
        retorne criar_racional(0, 1)
    fim_se

    retorne multiplicar_racionais(r1, inverso_racional(r2))
fim

procedimento imprimir_racional(rotulo: Texto, r: rational_t)
inicio
    Escrever(rotulo)
    Escrever(r.numerador)
    Escrever("/")
    Escrever(r.denominador)
    Escrever("")
fim

procedimento main() inicio
    a: rational_t = criar_racional(1, 2)
    b: rational_t = criar_racional(3, 4)

    Escrever("Racionais criados:")
    imprimir_racional("a = ", a)
    imprimir_racional("b = ", b)

    Escrever("a == b? ")
    se (racionais_iguais(a, b) == Verdadeiro) inicio
        Escrever("Verdadeiro")
    senao inicio
        Escrever("Falso")
    fim_se
    Escrever("")

    imprimir_racional("Soma = ", somar_racionais(a, b))
    imprimir_racional("Negacao de a = ", negar_racional(a))
    imprimir_racional("Subtracao = ", subtrair_racionais(a, b))
    imprimir_racional("Produto = ", multiplicar_racionais(a, b))
    imprimir_racional("Inverso de a = ", inverso_racional(a))
    imprimir_racional("Divisao = ", dividir_racionais(a, b))
fim
