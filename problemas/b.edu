// PROBLEMA 6: Arvore Binaria de Busca simulada com vetores paralelos
// chave[i], esq[i], dir[i], nivel[i]
// -1 = nulo

// Insere valor na arvore, retorna indice do no raiz
procedimento inserir(ref chave: Inteiro[], ref esq: Inteiro[], ref dir: Inteiro[], ref nivel: Inteiro[], ref tamanho: Inteiro, no: Inteiro, valor: Inteiro, lvl: Inteiro, ref resultado: Inteiro) inicio
    se (no == -1) inicio
        chave[tamanho] = valor
        esq[tamanho] = -1
        dir[tamanho] = -1
        nivel[tamanho] = lvl
        resultado = tamanho
        tamanho += 1
    senao inicio
        se (valor <= chave[no]) inicio
            inserir(chave, esq, dir, nivel, tamanho, esq[no], valor, lvl + 1, esq[no])
        senao inicio
            inserir(chave, esq, dir, nivel, tamanho, dir[no], valor, lvl + 1, dir[no])
        fim_se
        resultado = no
    fim_se
fim

// Busca minimo: vai sempre para esquerda
procedimento minimo(ref chave: Inteiro[], ref esq: Inteiro[], ref nivel: Inteiro[], no: Inteiro, ref minVal: Inteiro, ref minNivel: Inteiro) inicio
    se (no != -1) inicio
        se (esq[no] == -1) inicio
            minVal = chave[no]
            minNivel = nivel[no]
        senao inicio
            minimo(chave, esq, nivel, esq[no], minVal, minNivel)
        fim_se
    fim_se
fim

// Busca maximo: vai sempre para direita
procedimento maximo(ref chave: Inteiro[], ref dir: Inteiro[], ref nivel: Inteiro[], no: Inteiro, ref maxVal: Inteiro, ref maxNivel: Inteiro) inicio
    se (no != -1) inicio
        se (dir[no] == -1) inicio
            maxVal = chave[no]
            maxNivel = nivel[no]
        senao inicio
            maximo(chave, dir, nivel, dir[no], maxVal, maxNivel)
        fim_se
    fim_se
fim

// Imprime nivel por nivel usando fila simulada com vetor
procedimento imprimirNiveis(ref chave: Inteiro[], ref esq: Inteiro[], ref dir: Inteiro[], ref nivel: Inteiro[], raiz: Inteiro, tamanho: Inteiro) inicio
    fila: Inteiro[100]
    ini: Inteiro = 0
    fim: Inteiro = 0
    nivelAtual: Inteiro = 0
    no: Inteiro = 0

    se (raiz == -1) inicio
        Escrever("Arvore vazia")
    senao inicio
        fila[fim] = raiz
        fim += 1
        enquanto (ini < fim) inicio
            no = fila[ini]
            ini += 1
            se (nivel[no] != nivelAtual) inicio
                Escrever("--- novo nivel ---")
                nivelAtual = nivel[no]
            fim_se
            Escrever(chave[no])
            se (esq[no] != -1) inicio
                fila[fim] = esq[no]
                fim += 1
            fim_se
            se (dir[no] != -1) inicio
                fila[fim] = dir[no]
                fim += 1
            fim_se
        fim_enquanto
    fim_se
fim

procedimento main() inicio
    chave: Inteiro[100]
    esq: Inteiro[100]
    dir: Inteiro[100]
    nivel: Inteiro[100]
    tamanho: Inteiro = 0
    raiz: Inteiro = -1
    n: Inteiro = 0
    valor: Inteiro = 0
    minVal: Inteiro = 0
    minNivel: Inteiro = 0
    maxVal: Inteiro = 0
    maxNivel: Inteiro = 0
    i: Inteiro = 0

    Escrever("Quantos valores?")
    n = LerInteiro()

    enquanto (i < n) inicio
        Escrever("Valor:")
        valor = LerInteiro()
        inserir(chave, esq, dir, nivel, tamanho, raiz, valor, 0, raiz)
        i += 1
    fim_enquanto

    minimo(chave, esq, nivel, raiz, minVal, minNivel)
    Escrever("Minimo:")
    Escrever(minVal)
    Escrever("Nivel do minimo:")
    Escrever(minNivel)

    maximo(chave, dir, nivel, raiz, maxVal, maxNivel)
    Escrever("Maximo:")
    Escrever(maxVal)
    Escrever("Nivel do maximo:")
    Escrever(maxNivel)

    Escrever("Arvore nivel a nivel:")
    imprimirNiveis(chave, esq, dir, nivel, raiz, tamanho)
fim
